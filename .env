# ============================================
# SAMS - Local Development Environment
# ============================================
# DO NOT COMMIT THIS FILE TO GIT
# Copy from .env.example and adjust for your environment

DB_HOST=localhost
DB_PORT=3306
DB_NAME=sams_db
DB_USER=root
DB_PASS=

APP_ENV=development
APP_DEBUG=true

UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png

SESSION_TIMEOUT=3600
BCRYPT_COST=10

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
